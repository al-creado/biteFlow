{
  "name": "biteflow",
  "version": "1.0.0",
  "description": "Amylicious order tracker",
  "main": "main.js",
  "author": "Amylicious",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node tests/e2e/local-flow.js && node tests/e2e/auth-ui.js && node tests/e2e/weekends.js",
    "build:vendor": "cd vendor-src && npm install && npm run build"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.biteflow.app",
    "productName": "Amylicious",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "updater.js",
      "app/**/*",
      "build/icon.png"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.business",
      "artifactName": "Amylicious-${version}.${ext}"
    },
    "win": {
      "target": "nsis",
      "artifactName": "Amylicious-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "al-creado",
        "repo": "biteFlow"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}
