{
  "name": "biteflow",
  "version": "1.0.0",
  "description": "biteFlow order tracker",
  "main": "main.js",
  "author": "biteFlow",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.biteflow.app",
    "productName": "biteFlow",
    "directories": { "buildResources": "build" },
    "files": ["main.js", "app/**/*", "build/icon.png"],
    "mac": { "target": "dmg", "category": "public.app-category.business" },
    "win": { "target": "nsis" }
  }
}
